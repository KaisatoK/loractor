# Copy to .env and fill in the keys: `cp .env.example .env`.
# `bash ./bootstrap.sh` does that copy for you and tells you what is missing.
# .env is gitignored and loaded on import by src/backend/__init__.py and
# src/ui/__init__.py.

# --- Provider keys ---------------------------------------------------------
# All four are read at import time, because the chat clients and the TypeSafe
# classifier are built then: the backend will not start until each has a value.
# GOOGLE_API_KEY is also the key the database's embedding secret is created
# from, so the template embeddings use the same account.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
TYPESAFE_API_KEY=

# --- SereneDB --------------------------------------------------------------
# The port is the one published on the host. With `bash ./bootstrap.sh --db
# native` the server listens on 7890; with Docker, docker-compose.yml pins the
# mapping to this value so it cannot drift when the container is recreated.
SERENEDB_HOST=localhost
SERENEDB_PORT=7890
SERENEDB_DB=postgres
SERENEDB_USER=postgres
SERENEDB_PASSWORD=postgres

# --- Corpus sources --------------------------------------------------------
# BGL.log is 743 MB and is not in the repository (loghub license). Point this
# at a local download, or leave it and bootstrap.sh loads the bundled 2,000-row
# sample instead.
# BGL_LOG_PATH=/path/to/BGL.log

# --- Embeddings (optional) -------------------------------------------------
# Only the opt-in template embeddings use these. EMBEDDING_SECRET names the
# server-side secret `ai_embed` resolves its endpoint and key from;
# bootstrap.sh creates it as a PERSISTENT secret from GOOGLE_API_KEY.
# EMBEDDING_DIMENSION must equal what the model really returns -- the table
# casts to it, so a wider vector is truncated rather than refused.
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSION=3072
# EMBEDDING_SECRET=gemini
#
# The three must match the model that BUILT the stored template vectors, or
# search silently stays lexical (check `search_mode` in a search result and
# `uv run python -m backend.db.provision --report`). The deployment this repo is
# developed against uses:
#   EMBEDDING_MODEL=nomic-embed-text:v1.5  EMBEDDING_DIMENSION=768  EMBEDDING_SECRET=local_ai
# TEMPLATE_VECTOR_CACHE_TTL_S=60   # how long "vectors available" is cached

# --- Ports -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- Auth ------------------------------------------------------------------
# The demo auto-login is on by default; set false to see the real sign-in page.
AUTH_REGISTRATION_OPEN=false
# AUTH_DEMO_AUTOLOGIN=true

# --- MCP tool service (optional) -------------------------------------------
# The MCP server (bash ./mcp_server.sh) and the app are independent: the app
# does not need it, and an external agent connects to it directly. Set
# TOOLS_TRANSPORT=mcp to route the app's own evidence tools through it.
# A non-loopback MCP_HOST requires MCP_AUTH_TOKEN; loopback does not.
# MCP_HOST=127.0.0.1
# MCP_PORT=8010
# MCP_PATH=/mcp
# MCP_AUTH_TOKEN=
# TOOLS_TRANSPORT=mcp
#
# How long the pipeline's MCP bridge waits for an ordinary tool call, in
# seconds. 60 (the built-in default) is shorter than an OTel search that has to
# build its in-place index (~450s), so set 500 when the app uses the MCP
# transport. The long-running sweep tools use MCP_SWEEP_TIMEOUT_S instead.
# MCP_CALL_TIMEOUT_S=500
