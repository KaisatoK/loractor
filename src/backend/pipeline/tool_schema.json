{
    "tool_catalog": {
        "name": "log_database_tools",
        "description": "Tools for querying application logs. All timestamps must use YYYY-MM-DD HH:MM:SS format unless otherwise specified.",
        "shared_types": {
            "TableName": {
                "type": "string",
                "enum": [
                    "log"
                ],
                "default": "log",
                "description": "Database table containing log records. Currently only \"log\" is supported. When omitted \"log\" is default, can not be null."
            },
            "LogCategory": {
                "type": "string",
                "enum": [
                    "INFO",
                    "WARNING",
                    "ERROR"
                ],
                "description": "Exact log severity. When omitted results may include all severities."
            },
            "Timestamp": {
                "type": "string",
                "format": "datetime",
                "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                "example": "2026-10-07 09:00:00",
                "description": "Timestamp in YYYY-MM-DD HH:MM:SS format."
            }
        },
        "usage_rules": [
            "Use only the tools defined in this catalog.",
            "Do not invent process IDs, timestamps, categories, table names, or limits.",
            "A PID must come directly from the user or previously collected evidence.",
            "Time-window boundaries are inclusive.",
            "Put severity values in the category argument, never in query_text.",
            "A failed tool call means evidence is unavailable.",
            "Use not_found only when a successful tool call returns no matching rows.",
            "Never fabricate database results.",
            "The only supported table_name value is \"log\".",
            "Omit optional arguments when no valid value is known.",
            "Do not pass null unless the tool-calling interface requires explicit nulls."
        ],
        "tools": [
